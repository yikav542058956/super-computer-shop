{
  "version": 2,
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/super-computer run build",
  "outputDirectory": "artifacts/super-computer/dist/public",
  "framework": null,
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/api/cashfree/:path*", "destination": "/api/cashfree/:path*" },
    { "source": "/api/proxy/:path*",    "destination": "/api/proxy/:path*" },
    { "source": "/(.*)",                "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; frame-src *; connect-src *; script-src * 'unsafe-inline' 'unsafe-eval'; img-src * data: blob:;"
        }
      ]
    }
  ]
}
